+def _cutout(img, holes, fill_value):
+    """ [OrbitLight patch] albumentations>=1.4 removed A.functional.cutout; same behavior as the old one """
+    img = img.copy()
+    # SPNv2 draws fill_value with random.randint(0, 256) (256 included). Old NumPy wrapped 256 -> 0 for uint8;
+    # NumPy 2 raises OverflowError. Keep the old behavior.
+    if img.dtype == np.uint8:
+        fill_value = int(fill_value) % 256
+    for x1, y1, x2, y2 in holes:
+        img[y1:y2, x1:x2] = fill_value
+    return img
+
