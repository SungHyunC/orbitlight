+def _fill_none(d):
+    """ [OrbitLight patch] Replace None entries (e.g., rejected heatmap poses) with NaN
+        so that scipy.io.savemat can write them. Newer SciPy refuses None. """
+    out = {}
+    for k, v in d.items():
+        if isinstance(v, list) and any(e is None for e in v):
+            ref = next((e for e in v if e is not None), None)
+            shape = np.shape(ref) if ref is not None else ()
+            v = [np.full(shape, np.nan) if e is None else e for e in v]
+        out[k] = v
+    return out
